# Local defaults use SQLite so the demo runs with no external services.
# For the intended production setup, use PostgreSQL:
DATABASE_URL=postgresql+psycopg://relay:relay@localhost:5432/relay
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=480
ADMIN_EMAIL=admin@acme.co
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Acme Administrator
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=service-account@your-company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=IT
JIRA_ISSUE_TYPE=Task
JIRA_AUTO_SYNC=false
JIRA_WEBHOOK_SECRET=replace-with-a-webhook-secret
RUN_WORKER=true
CORS_ORIGINS=*
