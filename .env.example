# Local defaults use SQLite so the demo runs with no external services.
# For the intended production setup, use PostgreSQL:
DATABASE_URL=postgresql+psycopg://relay:relay@localhost:5432/relay
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=480
ADMIN_EMAIL=admin@acme.co
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Acme Administrator
CORS_ORIGINS=*
