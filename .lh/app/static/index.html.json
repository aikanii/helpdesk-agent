            "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Relay · AI IT Helpdesk</title>\n    <meta name=\"description\" content=\"AI-powered IT helpdesk operations dashboard\" />\n    <link rel=\"stylesheet\" href=\"/static/styles.css\" />\n  </head>\n  <body>\n    <div class=\"app-shell\">\n      <aside class=\"sidebar\">\n        <div class=\"brand\"><span class=\"brand-mark\"><span></span><span></span><span></span></span><span>relay</span></div>\n        <div class=\"workspace-switcher\"><div class=\"workspace-icon\">A</div><div><strong>Acme, Inc.</strong><small>IT Operations</small></div><span class=\"chevron\">⌄</span></div>\n        <nav class=\"nav-section\">\n          <p class=\"nav-label\">Workspace</p>\n          <a class=\"nav-link active\" href=\"#overview\"><span class=\"nav-icon\">⌂</span> Overview</a>\n          <a class=\"nav-link\" href=\"#queue\"><span class=\"nav-icon\">≡</span> My queue <b class=\"nav-count\">8</b></a>\n          <a class=\"nav-link\" href=\"#knowledge\"><span class=\"nav-icon\">◈</span> Knowledge base</a>\n          <a class=\"nav-link\" href=\"#analytics\"><span class=\"nav-icon\">◒</span> Analytics</a>\n          <p class=\"nav-label team-label\">Manage</p>\n          <a class=\"nav-link\" href=\"#team\"><span class=\"nav-icon\">◎</span> Team & routing</a>\n          <a class=\"nav-link\" href=\"#settings\"><span class=\"nav-icon\">⚙</span> Settings</a>\n        </nav>\n        <div class=\"sidebar-footer\">\n          <div class=\"plan-card\"><div class=\"plan-top\"><span>AI AGENT USAGE</span><span>84%</span></div><div class=\"progress\"><span style=\"width:84%\"></span></div><p>420 of 500 automated runs</p><button>Manage plan <span>→</span></button></div>\n          <div class=\"profile\"><div class=\"avatar purple\">AM</div><div><strong>Alex Morgan</strong><small>Administrator</small></div><span class=\"dots\">•••</span></div>\n        </div>\n      </aside>\n\n      <main class=\"main-content\" id=\"overview\">\n        <header class=\"topbar\"><div class=\"breadcrumbs\"><span>Workspace</span><span>/</span><strong>Overview</strong></div><div class=\"top-actions\"><button class=\"icon-button\" aria-label=\"Search\">⌕</button><button class=\"icon-button notification\" aria-label=\"Notifications\">♧<i></i></button><div class=\"top-avatar\">AM</div></div></header>\n        <section class=\"page-heading\"><div><p class=\"eyebrow\">TUESDAY, SEPTEMBER 15, 2026</p><h1>Good morning, Alex <span class=\"wave\">✦</span></h1><p class=\"subheading\">Here's what your helpdesk needs attention on today.</p></div><button class=\"button secondary\" id=\"newRequestBtn\"><span>＋</span> New request</button></section>\n\n        <section class=\"hero-grid\">\n          <div class=\"agent-card\">\n            <div class=\"agent-copy\"><div class=\"sparkle\">✦</div><div><div class=\"agent-kicker\">RELAY AI AGENT <span class=\"live-dot\"></span> ONLINE</div><h2>What can I help you solve?</h2><p>Describe an IT issue in plain language. I’ll search your runbooks, suggest next steps, and route a ticket if needed.</p></div></div>\n            <div class=\"composer\"><textarea id=\"issueInput\" rows=\"3\" placeholder=\"e.g. I can't connect to the VPN from home...\">I can't connect to the VPN from home. It keeps timing out after I enter my MFA code.</textarea><div class=\"composer-footer\"><div class=\"composer-tools\"><button class=\"tool-button\" title=\"Attach file\">⌇ <span>Attach</span></button><button class=\"tool-button\" title=\"Add context\">◌ <span>Add context</span></button></div><button class=\"button primary\" id=\"diagnoseBtn\"><span class=\"button-sparkle\">✦</span> Run diagnosis <span class=\"arrow\">→</span></button></div></div>\n            <div class=\"suggestions\"><span>Try a quick start</span><button class=\"suggestion\" data-prompt=\"My password is locked and I can't sign in\">Password reset</button><button class=\"suggestion\" data-prompt=\"Slack has been slow for everyone on my team\">Service outage</button><button class=\"suggestion\" data-prompt=\"My laptop has become very slow since the last update\">Slow laptop</button></div>\n          </div>\n          <div class=\"health-card\"><div class=\"card-heading\"><div><p class=\"eyebrow\">SYSTEM PULSE</p><h3>Operational health</h3></div><button class=\"more-button\">•••</button></div><div class=\"health-score\"><div class=\"ring\"><div><strong>98</strong><span>/ 100</span></div></div><div><div class=\"healthy\"><span class=\"status-dot\"></span> All systems healthy</div><p>Last checked 2 minutes ago</p></div></div><div class=\"health-list\"><div><span><i class=\"service-icon green\">⌁</i> Identity & access</span><b>Operational</b></div><div><span><i class=\"service-icon green\">✣</i> Collaboration tools</span><b>Operational</b></div><div><span><i class=\"service-icon amber\">◈</i> Network services</span><b>Degraded</b></div></div><button class=\"text-button\">View status page <span>→</span></button></div>\n        </section>\n\n        <section class=\"result-panel hidden\" id=\"resultPanel\"></section>\n\n        <section class=\"stats-grid\" aria-label=\"Helpdesk summary\"><div class=\"stat-card\"><div class=\"stat-icon blue\">◒</div><div><span class=\"stat-label\">OPEN TICKETS</span><strong id=\"openStat\">—</strong><small class=\"trend up\">↑ 12% <em>vs. last week</em></small></div><div class=\"sparkline blue-line\">╱╲╱╲╱╲╱╲</div></div><div class=\"stat-card\"><div class=\"stat-icon orange\">!</div><div><span class=\"stat-label\">NEEDS ATTENTION</span><strong id=\"urgentStat\">—</strong><small class=\"trend down\">↓ 8% <em>vs. last week</em></small></div><div class=\"sparkline orange-line\">╲╱╲╱╲╱╲╱</div></div><div class=\"stat-card\"><div class=\"stat-icon violet\">✦</div><div><span class=\"stat-label\">AI AUTOMATION RATE</span><strong id=\"automationStat\">—</strong><small class=\"trend up\">↑ 6% <em>vs. last month</em></small></div><div class=\"sparkline violet-line\">╱╲╱╲╱╲╱╲</div></div><div class=\"stat-card\"><div class=\"stat-icon teal\">◷</div><div><span class=\"stat-label\">AVG. RESPONSE TIME</span><strong id=\"responseStat\">—</strong><small class=\"trend up\">↑ 18% <em>faster this week</em></small></div><div class=\"sparkline teal-line\">╱╲╱╲╱╲╱╲</div></div></section>\n\n        <section class=\"lower-grid\" id=\"queue\">\n          <div class=\"queue-card card\"><div class=\"section-heading\"><div><div class=\"title-row\"><h2>My queue</h2><span class=\"count-badge\" id=\"queueCount\">—</span></div><p>Tickets that need your attention</p></div><div class=\"queue-actions\"><button class=\"filter-button\" id=\"statusFilter\">All statuses <span>⌄</span></button><button class=\"more-button\">•••</button></div></div><div class=\"table-wrap\"><table><thead><tr><th>Ticket</th><th>Requester</th><th>Priority</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody id=\"ticketRows\"><tr><td colspan=\"6\" class=\"loading\">Loading queue…</td></tr></tbody></table></div><div class=\"card-footer\"><span id=\"queueSummary\">Showing recent tickets</span><button class=\"text-button\">View all tickets <span>→</span></button></div></div>\n          <div class=\"knowledge-card card\" id=\"knowledge\"><div class=\"section-heading\"><div><h2>Knowledge base</h2><p>Top runbooks for your team</p></div><button class=\"more-button\">•••</button></div><div id=\"docList\" class=\"doc-list\"><div class=\"loading\">Loading runbooks…</div></div><div class=\"card-footer\"><button class=\"text-button\">Browse all documentation <span>→</span></button></div></div>\n        </section>\n        <footer class=\"page-footer\"><span>Relay Helpdesk v0.1</span><span><span class=\"footer-dot\"></span> API connected</span><span>⌘ K to search</span></footer>\n      </main>\n    </div>\n    <div id=\"ticketModal\" class=\"modal hidden\" aria-hidden=\"true\">\n      <div class=\"modal-backdrop\" data-close-modal=\"true\"></div>\n      <section class=\"modal-dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modalTitle\">\n        <div class=\"modal-head\"><div><p class=\"eyebrow\">TICKET DETAILS</p><h2 id=\"modalTitle\">Loading ticket…</h2></div><button class=\"modal-close\" id=\"closeModal\" aria-label=\"Close\">×</button></div>\n        <div id=\"ticketDetail\" class=\"modal-content\"><div class=\"loading\">Loading ticket details…</div></div>\n      </section>\n    </div>\n    <div id=\"toast\" class=\"toast\"></div>\n    <script src=\"/static/app.js\"></script>\n  <script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a3b8577f8c564100',t:'MTc4OTQ4Mjc1Nw=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n"
